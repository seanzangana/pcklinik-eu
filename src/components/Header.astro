---
import { site, nav } from '../data/site.js';
import { lucideSm } from '../data/icons.js';
const { path } = Astro.props;
function isActive(item) {
  if (item.href === '/') return path === '/';
  if (path === item.href) return true;
  if (item.children) return item.children.some((c) => path === c.href);
  if (item.flyout) return item.flyout.some((cat) => cat.children.some((c) => path === c.href));
  return false;
}
---
<div class="topbar">
  <div class="wrap">
    <span><Fragment set:html={lucideSm.clock} /> {site.hours}</span>
    <span><Fragment set:html={lucideSm.phone} /> <a href={site.phoneHref}>{site.phone}</a></span>
    <span><Fragment set:html={lucideSm.mail} /> <a href={`mailto:${site.emailConsumer}`}>{site.emailConsumer}</a></span>
  </div>
</div>

<header class="site-header">
  <div class="wrap">
    <a href="/" class="brand" aria-label="PCKlinik home">
      <img src="/logo.png" alt="PCKlinik" width="100" height="40" />
    </a>

    <nav class="main" id="mainnav">
      {nav.map((item) => (
        item.flyout ? (
          <div class="nav-item dropdown flyout">
            <a href={item.href} class={isActive(item) ? 'active' : ''}>{item.label} <span aria-hidden="true">▾</span></a>
            <div class="dropdown-menu flyout-menu">
              {item.flyout.map((cat) => (
                <div class="flyout-cat">
                  <button type="button" class="flyout-cat-label">{cat.label} <span aria-hidden="true">▸</span></button>
                  <div class="flyout-panel">
                    {cat.children.map((c) => <a href={c.href}>{c.label}</a>)}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ) : item.children ? (
          <div class="nav-item dropdown">
            <a href={item.href} class={isActive(item) ? 'active' : ''}>{item.label} <span aria-hidden="true">▾</span></a>
            <div class="dropdown-menu">
              {item.children.map((c) => c.header ? <span class="dropdown-header">{c.header}</span> : <a href={c.href}>{c.label}</a>)}
            </div>
          </div>
        ) : (
          <div class="nav-item">
            <a href={item.href} class={isActive(item) ? 'active' : ''}>{item.label}</a>
          </div>
        )
      ))}
    </nav>

    <button class="nav-toggle" id="navtoggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const t = document.getElementById('navtoggle');
  const n = document.getElementById('mainnav');
  t?.addEventListener('click', () => {
    const open = n?.classList.toggle('open');
    t.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  document.querySelectorAll('.flyout-cat-label').forEach((b) => b.addEventListener('click', () => b.parentElement.classList.toggle('expanded')));
</script>
